{
  "manifest_version": 3,
  "name": "Claude Code Sessions Search & Filter",
  "version": "1.0.0",
  "description": "Adds search bar and repository filter to Claude Code web sessions",
  "permissions": [],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/code*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
